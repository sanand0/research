+export function activityTarget(value) {
+  if (value.includes('://')) {
+    const url = linkedinUrl(value);
+    if (url.pathname.startsWith('/company/')) return { company: profileIdentifier(decodeURIComponent(url.pathname.split('/')[2] ?? '')) };
+  }
+  const company = value.match(/^urn:li:(?:fsd_company|company|organization):(\d+)$/);
+  return company ? {company:company[1]} : profileTarget(value);
+}
+export async function resolveActivityTarget(value, client, lookup) {
+  const target = activityTarget(value);
+  if (target.company) return client.company(target.company);
+  if (target.identifier) {
+    try { return await client.profile(target.identifier); }
+    catch (error) {
+      if (value.includes('://') || value.startsWith('urn:') || value === 'me' || !['NOT_FOUND','FORBIDDEN'].includes(error.code)) throw error;
