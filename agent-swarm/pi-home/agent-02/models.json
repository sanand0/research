{
  "providers": {
    "swarm": {
      "name": "Swarm budget proxy",
      "baseUrl": "http://budget-proxy:8721/v1",
      "api": "openai-completions",
      "apiKey": "local-no-upstream-key",
      "headers": {
        "X-Swarm-Agent": "agent-02"
      },
      "models": [
        {
          "id": "openai/gpt-6-luna",
          "name": "GPT-6 Luna via OpenRouter budget proxy",
          "reasoning": true,
          "input": [
            "text"
          ],
          "contextWindow": 272000,
          "maxTokens": 8192,
          "cost": {
            "input": 0.1,
            "output": 0.5,
            "cacheRead": 0.01,
            "cacheWrite": 0.1
          }
        }
      ]
    }
  }
}
