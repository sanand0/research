{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-browser-run-samples",
  "main": "src/index.js",
  "compatibility_date": "2026-04-24",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "MYBROWSER"
  },
  "observability": {
    "enabled": true
  }
}
